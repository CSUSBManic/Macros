Private Function NodeLabel(ByVal v As Long, ByRef projDisp() As String, ByRef ids() As Long) As String
    NodeLabel = projDisp(v) & "\" & ids(v)
End Function

Private Function SafeStr(ByVal x As Variant) As String
    If IsError(x) Then SafeStr = "" Else SafeStr = CStr(x & "")
End Function

Private Function FindHeaderRow(ws As Worksheet) As Long
    Dim r As Long, c As Long, lastC As Long, hasID As Boolean, hasPred As Boolean, t As String
    For r = 1 To 20
        lastC = ws.Cells(r, ws.Columns.Count).End(xlToLeft).Column
        hasID = False: hasPred = False
        For c = 1 To lastC
            t = UCase$(Trim$(SafeStr(ws.Cells(r, c).Value)))
            If t = "ID" Then hasID = True
            If t = "PREDECESSORS" Then hasPred = True
        Next c
        If hasID And hasPred Then FindHeaderRow = r: Exit Function
    Next r
    FindHeaderRow = 0
End Function

Private Function FindCol(ws As Worksheet, ByVal hdrRow As Long, ByVal lastCol As Long, ByVal name As String) As Long
    Dim c As Long
    For c = 1 To lastCol
        If UCase$(Trim$(SafeStr(ws.Cells(hdrRow, c).Value))) = UCase$(name) Then FindCol = c: Exit Function
    Next c
    FindCol = 0
End Function

Private Function SheetExists(wb As Workbook, ByVal nm As String) As Boolean
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = wb.Worksheets(nm)
    On Error GoTo 0
    SheetExists = Not ws Is Nothing
End Function

' Delete + recreate a sheet by name, placed after "afterWs"
Private Function GetFreshSheet(wb As Workbook, ByVal nm As String, afterWs As Worksheet) As Worksheet
    Dim prevAlerts As Boolean
    If SheetExists(wb, nm) Then
        prevAlerts = Application.DisplayAlerts
        Application.DisplayAlerts = False
        wb.Worksheets(nm).Delete
        Application.DisplayAlerts = prevAlerts
    End If
    Set GetFreshSheet = wb.Worksheets.Add(After:=afterWs)
    GetFreshSheet.Name = nm
End Function

' Build a legal, unique sheet name from the PUID (fallback: Project\ID)
Private Function SafeSheetName(wb As Workbook, ByVal puid As String, ByVal proj As String, ByVal id As Long) As String
    Dim bad As Variant, i As Long, base As String, s As String, k As Long, suffix As String
    s = Trim$(puid)
    If Len(s) = 0 Then s = "Loop_" & proj & "_" & id
    bad = Array(":", "\", "/", "?", "*", "[", "]", "'")
    For i = LBound(bad) To UBound(bad)
        s = Replace(s, bad(i), "_")
    Next i
    If Len(s) > 31 Then s = Left$(s, 31)
    base = s: k = 1
    Do While SheetExists(wb, s)
        k = k + 1
        suffix = " (" & k & ")"
        s = Left$(base, 31 - Len(suffix)) & suffix
    Loop
    SafeSheetName = s
End Function
