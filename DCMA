Private Sub ColorStatus(rng As Range)
    rng.Font.Bold = True
    rng.HorizontalAlignment = xlCenter
    Select Case UCase(CStr(rng.Value))
        Case "PASS"
            rng.Interior.Color = RGB(198, 239, 206): rng.Font.Color = RGB(0, 97, 0)
        Case "FAIL"
            rng.Interior.Color = RGB(255, 199, 206): rng.Font.Color = RGB(156, 0, 6)
        Case Else
            rng.Interior.Color = RGB(237, 237, 237): rng.Font.Color = RGB(89, 89, 89)
    End Select
End Sub

