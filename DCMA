Private Function GetCell(data As Variant, r As Long, c As Long) As Variant
    If c = 0 Then GetCell = Empty Else GetCell = data(r, c)
End Function

Private Function GetStr(data As Variant, r As Long, c As Long) As String
    If c = 0 Then Exit Function
    If IsError(data(r, c)) Or IsNull(data(r, c)) Then Exit Function
    GetStr = CStr(data(r, c))
End Function

Private Function ParseBool(s As String) As Boolean
    Select Case LCase(Trim(s))
        Case "yes", "true", "-1", "1", "y": ParseBool = True
    End Select
End Function

' Accepts a cell value that may be a real date, a serial number, or text
' such as "Mon 1/6/25 8:00 AM" or "NA"
Private Function TryDate(v As Variant, ByRef d As Date) As Boolean
    Dim s As String, p As Long
    If IsEmpty(v) Or IsError(v) Or IsNull(v) Then Exit Function
    Select Case VarType(v)
        Case vbDate
            d = v: TryDate = True
        Case vbDouble, vbSingle, vbLong, vbInteger, vbCurrency, vbDecimal
            If v > 20000 Then d = CDate(v): TryDate = True
        Case vbString
            s = Trim(v)
            If Len(s) = 0 Or UCase(s) = "NA" Then Exit Function
            If IsDate(s) Then
                d = CDate(s): TryDate = True
            Else
                p = InStr(s, " ")                     ' strip leading weekday name
                If p > 0 Then
                    s = Trim(Mid(s, p + 1))
                    If IsDate(s) Then d = CDate(s): TryDate = True
                End If
            End If
    End Select
End Function

' Converts MS Project duration text ("10 days", "5 days?", "8 hrs", "2 wks",
' "1 mon", "3 edays", "-2 days", "+10%") to a number of days
Private Function ParseDurationDays(txt As String) As Double
    Dim t As String, n As Double
    t = LCase(Trim(txt))
    If Len(t) = 0 Then Exit Function
    t = Replace(t, "?", "")
    t = Replace(t, "+", "")
    If IsNumeric(t) Then
        ParseDurationDays = CDbl(t)
        Exit Function
    End If
    n = Val(t)
    If InStr(t, "mo") > 0 Then            ' mon(s), month(s)
        n = n * DAYS_PER_MONTH
    ElseIf InStr(t, "w") > 0 Then         ' wk(s), week(s)
        n = n * DAYS_PER_WEEK
    ElseIf InStr(t, "h") > 0 Then         ' hr(s), hour(s)
        n = n / HOURS_PER_DAY
    ElseIf InStr(t, "mi") > 0 Then        ' min(s)
        n = n / (HOURS_PER_DAY * 60)
    End If                                ' day(s), eday(s), % lag: left as-is
    ParseDurationDays = n
End Function

' Parses one predecessor token such as "12", "12FS", "12SS+2 days", "12FF-1 day",
' "Other.mpp\12FS" into ID, relationship type and lag (days, signed)
Private Function ParseLink(token As String, ByRef pid As Long, ByRef relType As String, ByRef lagDays As Double) As Boolean
    Dim t As String, i As Long, digits As String, rest As String
    pid = 0: relType = "FS": lagDays = 0
    t = Trim(token)
    If Len(t) = 0 Then Exit Function
    If InStr(t, "\") > 0 Then t = Mid(t, InStrRev(t, "\") + 1)   ' external link

    i = 1
    Do While i <= Len(t)
        If Mid(t, i, 1) Like "#" Then
            digits = digits & Mid(t, i, 1)
            i = i + 1
        Else
            Exit Do
        End If
    Loop
    If Len(digits) = 0 Then Exit Function
    pid = CLng(digits)

    rest = Trim(Mid(t, i))
    If Len(rest) >= 2 Then
        Select Case UCase(Left(rest, 2))
            Case "FS", "SS", "FF", "SF"
                relType = UCase(Left(rest, 2))
                rest = Trim(Mid(rest, 3))
        End Select
    End If
    If Len(rest) > 0 Then lagDays = ParseDurationDays(rest)
    ParseLink = True
End Function

Private Function TaskNameByID(pid As Long) As String
    Dim idx As Long
    On Error Resume Next
    idx = IdMap.Item(CStr(pid))
    On Error GoTo 0
    If idx > 0 Then TaskNameByID = Tasks(idx).Name Else TaskNameByID = "not in export"
End Function
