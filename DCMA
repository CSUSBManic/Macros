Private Sub WriteOutput(wsData As Worksheet)
    Dim wb As Workbook, k As Long, wsSum As Worksheet, prev As Worksheet
    Set wb = wsData.Parent

    Application.DisplayAlerts = False
    DeleteSheetIfExists wb, SUMMARY_SHEET
    For k = 1 To 14
        DeleteSheetIfExists wb, Checks(k).SheetName
    Next k
    Application.DisplayAlerts = True

    Set wsSum = wb.Worksheets.Add(Before:=wb.Worksheets(1))
    wsSum.Name = SUMMARY_SHEET

    Set prev = wb.Worksheets(wb.Worksheets.Count)
    For k = 1 To 14
        Set prev = WriteCheckSheet(wb, k, prev)
    Next k

    WriteSummary wsSum, wsData
    wsSum.Activate
    wsSum.Range("A1").Select
End Sub

Private Function WriteCheckSheet(wb As Workbook, k As Long, afterWs As Worksheet) As Worksheet
    Dim ws As Worksheet, n As Long, i As Long, f As Variant, idx As Long
    Dim out() As Variant

    Set ws = wb.Worksheets.Add(After:=afterWs)
    ws.Name = Checks(k).SheetName

    With ws
        .Range("A1").Value = "DCMA Check " & k & ": " & Checks(k).Title
        .Range("A1").Font.Bold = True
        .Range("A1").Font.Size = 14
        .Range("A2").Value = "Description":  .Range("B2").Value = Checks(k).Description
        .Range("A3").Value = "Threshold":    .Range("B3").Value = Checks(k).Threshold
        .Range("A4").Value = "Result":       .Range("B4").Value = Checks(k).Metric
        .Range("A5").Value = "Status":       .Range("B5").Value = Checks(k).Result
        .Range("A6").Value = "Status Date":  .Range("B6").Value = StatusDate
        .Range("B6").NumberFormat = "dd-mmm-yyyy"
        .Range("A2:A6").Font.Bold = True
        ColorStatus .Range("B5")

        .Range("A8").Resize(1, 15).Value = Array("Finding", "ID", "Task Name", "% Complete", "Start", "Finish", _
            "Remaining Dur (days)", "Total Slack (days)", "Constraint Type", "Predecessors", "Successors", _
            "Baseline Finish", "Actual Start", "Actual Finish", "Resource Names")
        With .Range("A8:O8")
            .Font.Bold = True
            .Interior.Color = RGB(31, 78, 121)
            .Font.Color = vbWhite
        End With

        n = Findings(k).Count
        If n > 0 Then
            ReDim out(1 To n, 1 To 15)
            For i = 1 To n
                f = Findings(k).Item(i)
                idx = f(0)
                out(i, 1) = f(1)
                With Tasks(idx)
                    out(i, 2) = .ID
                    out(i, 3) = .Name
                    out(i, 4) = .PctComplete
                    If .HasStart Then out(i, 5) = .StartDt Else out(i, 5) = ""
                    If .HasFinish Then out(i, 6) = .FinishDt Else out(i, 6) = ""
                    out(i, 7) = Round(.RemDur, 2)
                    If cSlack > 0 Then out(i, 8) = .TotalSlack Else out(i, 8) = ""
                    out(i, 9) = .ConstraintType
                    out(i, 10) = .Preds
                    out(i, 11) = .Succs
                    If .HasBLFinish Then out(i, 12) = .BLFinish Else out(i, 12) = ""
                    If .HasActStart Then out(i, 13) = .ActStart Else out(i, 13) = ""
                    If .HasActFinish Then out(i, 14) = .ActFinish Else out(i, 14) = ""
                    out(i, 15) = .Resources
                End With
            Next i
            .Range("A9").Resize(n, 15).Value = out
            .Range("E9:F" & 8 + n).NumberFormat = "dd-mmm-yyyy"
            .Range("L9:N" & 8 + n).NumberFormat = "dd-mmm-yyyy"
            .Range("A8:O" & 8 + n).AutoFilter
            .Range("A8:O" & 8 + n).Borders.LineStyle = xlContinuous
        Else
            .Range("A9").Value = "No tasks tripped this check."
            .Range("A9").Font.Italic = True
        End If

        .Columns("A:O").AutoFit
        .Columns("A").ColumnWidth = 55
        .Columns("B").ColumnWidth = 8
        If .Columns("C").ColumnWidth > 50 Then .Columns("C").ColumnWidth = 50
        If .Columns("J").ColumnWidth > 35 Then .Columns("J").ColumnWidth = 35
        If .Columns("K").ColumnWidth > 35 Then .Columns("K").ColumnWidth = 35
        If .Columns("O").ColumnWidth > 35 Then .Columns("O").ColumnWidth = 35
    End With

    ws.Activate
    ActiveWindow.FreezePanes = False
    ws.Range("A9").Select
    ActiveWindow.FreezePanes = True

    Set WriteCheckSheet = ws
End Function

