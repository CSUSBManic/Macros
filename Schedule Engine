Private gStep As String

'================================================
' ENTRY POINT
'================================================
Public Sub RecalcSchedule()

    Dim ord() As Long
    Dim nOrd As Long
    Dim cyc As String
    Dim i As Long
    Dim msg As String

    gStep = "starting"
    On Error GoTo Fail

    gStep = "loading " & SRC_SHEET
    rcLoad

    gStep = "building working calendar"
    rcBuildCalendar

    gStep = "parsing relationships"
    rcBuildLinks

    gStep = "topological sort"
    nOrd = rcTopoSort(ord, cyc)
    If nOrd < rCount Then
        msg = "Cannot schedule: the network contains a circular reference."
        msg = msg & vbCrLf & vbCrLf & "Tasks involved in or downstream of the cycle:"
        msg = msg & vbCrLf & cyc
        MsgBox msg, vbExclamation, "Recalc"
        Exit Sub
    End If

    gStep = "forward pass"
    rcForwardPass ord, nOrd

    gStep = "writing " & OUT_SHEET
    rcWriteResults

    Exit Sub

Fail:
    MsgBox "Failed while: " & gStep & vbCrLf & vbCrLf & _
           "Error " & Err.Number & ": " & Err.Description, _
           vbExclamation, "Recalc"
End Sub

'================================================
' LOAD
'================================================
Private Sub rcLoad()
    Dim ws As Worksheet
    Dim lr As Long, lc As Long
    Dim i As Long, c As Long, n As Long
    Dim hdr As Object
    Dim k As String, sID As String
    Dim cID As Long, cNm As Long, cDur As Long
    Dim cSt As Long, cFi As Long, cPr As Long
    Dim cOD As Long, cSN As Long, cPn As Long
    Dim ok As Boolean
    Dim v As Variant

    Set ws = Nothing
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(SRC_SHEET)
    On Error GoTo 0
    If ws Is Nothing Then rcBail "Cannot find sheet " & SRC_SHEET

    lr = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    If lr <= SRC_HDR_ROW Then rcBail SRC_SHEET & " has no data rows."
    lc = ws.Cells(SRC_HDR_ROW, ws.Columns.Count).End(xlToLeft).Column

    Set hdr = CreateObject("Scripting.Dictionary")
    hdr.CompareMode = 1
    For c = 1 To lc
        k = rcNorm(CStr(ws.Cells(SRC_HDR_ROW, c).Value))
        If Len(k) > 0 Then
            If Not hdr.Exists(k) Then hdr.Add k, c
        End If
    Next c

    cID = rcFindCol(hdr, "taskid|id")
    cNm = rcFindCol(hdr, "name|taskname")
    cDur = rcFindCol(hdr, "currentduration|duration")
    cSt = rcFindCol(hdr, "currentstartdate|currentstart|startdate|start")
    cFi = rcFindCol(hdr, "currentfinishdate|currentfinish|finishdate|finish")
    cPr = rcFindCol(hdr, "predecessors|predecessor")
    cOD = rcFindCol(hdr, "overrideduration|newduration|whatifduration")
    cSN = rcFindCol(hdr, "snet|startnoearlierthan|constraintdate|overridestart")
    cPn = rcFindCol(hdr, "pin|pinned|locked|manual")

    If cID = 0 Then rcBail "No Task ID column on " & SRC_SHEET
    If cDur = 0 Then rcBail "No Duration column on " & SRC_SHEET
    If cSt = 0 Then rcBail "No Current Start Date column on " & SRC_SHEET
    If cFi = 0 Then rcBail "No Current Finish Date column on " & SRC_SHEET
    If cPr = 0 Then rcBail "No Predecessors column on " & SRC_SHEET

    n = lr - SRC_HDR_ROW
    ReDim rIDs(1 To n): ReDim rNames(1 To n)
    ReDim rDur(1 To n): ReDim rDurOK(1 To n)
    ReDim rStart0(1 To n): ReDim rFin0(1 To n)
    ReDim rStartOK(1 To n): ReDim rFinOK(1 To n)
    ReDim rSNET(1 To n): ReDim rSNETOK(1 To n)
    ReDim rPin(1 To n): ReDim rPredRaw(1 To n)

    Set rIdx = CreateObject("Scripting.Dictionary")
    rIdx.CompareMode = 0
    Set rUnparsed = CreateObject("Scripting.Dictionary")
    rUnparsed.CompareMode = 0

    rCount = 0
    For i = SRC_HDR_ROW + 1 To lr
        sID = Trim(CStr(ws.Cells(i, cID).Value))
        If Len(sID) > 0 Then
            rCount = rCount + 1
            rIDs(rCount) = sID
            If cNm > 0 Then rNames(rCount) = CStr(ws.Cells(i, cNm).Value)

            rDur(rCount) = 0
            rDurOK(rCount) = False
            v = ws.Cells(i, cDur).Value
            If cOD > 0 Then
                If Len(Trim(CStr(ws.Cells(i, cOD).Value))) > 0 Then v = ws.Cells(i, cOD).Value
            End If
            rDur(rCount) = rcToDur(v, ok)
            rDurOK(rCount) = ok

            rStart0(rCount) = rcToDate(ws.Cells(i, cSt).Value, ok)
            rStartOK(rCount) = ok
            rFin0(rCount) = rcToDate(ws.Cells(i, cFi).Value, ok)
            rFinOK(rCount) = ok

            rSNETOK(rCount) = False
            If cSN > 0 Then
                rSNET(rCount) = rcToDate(ws.Cells(i, cSN).Value, ok)
                rSNETOK(rCount) = ok
            End If

            rPin(rCount) = False
            If cPn > 0 Then rPin(rCount) = rcTruthy(ws.Cells(i, cPn).Value)

            rPredRaw(rCount) = CStr(ws.Cells(i, cPr).Value)
            If Not rIdx.Exists(sID) Then rIdx.Add sID, rCount
        End If
    Next i
    If rCount = 0 Then rcBail "No Task IDs found on " & SRC_SHEET
End Sub

'================================================
' CALENDAR
'================================================
Private Sub rcBuildCalendar()
    Dim i As Long, s As Long
    Dim lo As Double, hi As Double
    Dim anyD As Boolean
    Dim hol As Object
    Dim ws As Worksheet
    Dim lr As Long
    Dim ok As Boolean
    Dim d As Double
    Dim n As Long
    Dim o As Long

    anyD = False
    For i = 1 To rCount
        If rStartOK(i) Then
            If Not anyD Then
                lo = rStart0(i): hi = rStart0(i): anyD = True
            Else
                If rStart0(i) < lo Then lo = rStart0(i)
                If rStart0(i) > hi Then hi = rStart0(i)
            End If
        End If
        If rFinOK(i) Then
            If Not anyD Then
                lo = rFin0(i): hi = rFin0(i): anyD = True
            Else
                If rFin0(i) < lo Then lo = rFin0(i)
                If rFin0(i) > hi Then hi = rFin0(i)
            End If
        End If
        If rSNETOK(i) Then
            If rSNET(i) < lo Then lo = rSNET(i)
            If rSNET(i) > hi Then hi = rSNET(i)
        End If
    Next i
    If Not anyD Then rcBail "No parseable dates on " & SRC_SHEET & _
        ". Run VerifyProjectViewLoad first."

    Set hol = CreateObject("Scripting.Dictionary")
    hol.CompareMode = 0
    Set ws = Nothing
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(HOL_SHEET)
    On Error GoTo 0
    If Not ws Is Nothing Then
        lr = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
        For i = 1 To lr
            d = rcToDate(ws.Cells(i, 1).Value, ok)
            If ok Then
                If Not hol.Exists(CLng(d)) Then hol.Add CLng(d), 1
            End If
        Next i
    End If

    cBase = CLng(lo) - 366
    n = CLng(hi) + 366 * CAL_PAD_YEARS - cBase
    ReDim cIsWork(0 To n)
    ReDim cOrd(0 To n)
    ReDim cSer(1 To n + 1)

    o = 0
    For i = 0 To n
        s = cBase + i
        cIsWork(i) = rcIsWorkday(s, hol)
        If cIsWork(i) Then
            o = o + 1
            cSer(o) = s
        End If
        cOrd(i) = o
    Next i
    cMaxOrd = o
    If cMaxOrd = 0 Then rcBail "The working calendar has no working days. Check the WORK_* settings."

    ' cOrd currently holds the ordinal of the last working day at or before i.
    ' Convert to forward-snap: ordinal of the next working day at or after i.
    For i = 0 To n
        If Not cIsWork(i) Then cOrd(i) = cOrd(i) + 1
    Next i
End Sub

Private Function rcIsWorkday(ByVal s As Long, ByVal hol As Object) As Boolean
    Dim w As Long
    If hol.Exists(s) Then Exit Function
    w = Weekday(CDate(s), vbSunday)
    Select Case w
        Case 1: rcIsWorkday = WORK_SUN
        Case 2: rcIsWorkday = WORK_MON
        Case 3: rcIsWorkday = WORK_TUE
        Case 4: rcIsWorkday = WORK_WED
        Case 5: rcIsWorkday = WORK_THU
        Case 6: rcIsWorkday = WORK_FRI
        Case 7: rcIsWorkday = WORK_SAT
    End Select
End Function

Private Function rcOrdOf(ByVal d As Double) As Long
    Dim i As Long
    i = CLng(Int(d)) - cBase
    If i < 0 Then i = 0
    If i > UBound(cOrd) Then rcBail "Date falls outside the calendar range. Increase CAL_PAD_YEARS."
    rcOrdOf = cOrd(i)
    If rcOrdOf < 1 Then rcOrdOf = 1
    If rcOrdOf > cMaxOrd Then rcBail "Date falls beyond the calendar. Increase CAL_PAD_YEARS."
End Function

Private Function rcSerOf(ByVal o As Long) As Long
    If o < 1 Then o = 1
    If o > cMaxOrd Then rcBail "Schedule ran past the end of the calendar. Increase CAL_PAD_YEARS."
    rcSerOf = cSer(o)
End Function

'================================================
' LINKS
'================================================
Private Sub rcBuildLinks()
    Dim i As Long, j As Long, p As Long
    Dim toks() As String
    Dim t As String, pid As String, rest As String, code As String
    Dim lagV As Double
    Dim cap As Long

    cap = 16
    ReDim lkS(1 To cap): ReDim lkP(1 To cap)
    ReDim lkC(1 To cap): ReDim lkL(1 To cap)
    lkN = 0

    For i = 1 To rCount
        t = Trim(rPredRaw(i))
        If Len(t) > 0 Then
            toks = Split(t, ",")
            For j = LBound(toks) To UBound(toks)
                t = Trim(toks(j))
                If Len(t) > 0 Then
                    pid = rcLongestKnownID(t)
                    If Len(pid) = 0 Then
                        If rUnparsed.Count < 200 Then
                            If Not rUnparsed.Exists(t) Then rUnparsed.Add t, 1
                        End If
                    Else
                        rest = Mid(t, Len(pid) + 1)
                        code = "FS"
                        If Len(rest) >= 2 Then
                            Select Case UCase(Left(rest, 2))
                                Case "FS", "SS", "FF", "SF"
                                    code = UCase(Left(rest, 2))
                                    rest = Mid(rest, 3)
                            End Select
                        ElseIf Left(rest, 1) = "[" Then
                            p = InStr(rest, "]")
                            If p > 0 Then rest = Mid(rest, p + 1)
                        End If
                        lagV = rcParseLag(rest)
                        lkN = lkN + 1
                        If lkN > cap Then
                            cap = cap * 2
                            ReDim Preserve lkS(1 To cap): ReDim Preserve lkP(1 To cap)
                            ReDim Preserve lkC(1 To cap): ReDim Preserve lkL(1 To cap)
                        End If
                        lkS(lkN) = i
                        lkP(lkN) = rIdx(pid)
                        lkC(lkN) = code
                        lkL(lkN) = lagV
                    End If
                End If
            Next j
        End If
    Next i
End Sub

Private Function rcTopoSort(ByRef ord() As Long, ByRef cyc As String) As Long
    Dim indeg() As Long
    Dim q() As Long
    Dim i As Long, k As Long
    Dim head As Long, tail As Long
    Dim cur As Long
    Dim nOut As Long

    ReDim indeg(1 To rCount)
    ReDim ord(1 To rCount)
    ReDim q(1 To rCount)

    For i = 1 To lkN
        indeg(lkS(i)) = indeg(lkS(i)) + 1
    Next i

    head = 1: tail = 0
    For i = 1 To rCount
        If indeg(i) = 0 Then
            tail = tail + 1
            q(tail) = i
        End If
    Next i

    nOut = 0
    Do While head <= tail
        cur = q(head): head = head + 1
        nOut = nOut + 1
        ord(nOut) = cur
        For i = 1 To lkN
            If lkP(i) = cur Then
                indeg(lkS(i)) = indeg(lkS(i)) - 1
                If indeg(lkS(i)) = 0 Then
                    tail = tail + 1
                    q(tail) = lkS(i)
                End If
            End If
        Next i
    Loop

    If nOut < rCount Then
        k = 0
        For i = 1 To rCount
            If indeg(i) > 0 Then
                If k < 25 Then
                    cyc = cyc & rIDs(i) & "  "
                    k = k + 1
                    If k Mod 5 = 0 Then cyc = cyc & vbCrLf
                End If
            End If
        Next i
        If k >= 25 Then cyc = cyc & vbCrLf & "(list truncated)"
    End If
    rcTopoSort = nOut
End Function

'================================================
' FORWARD PASS
'================================================
Private Sub rcForwardPass(ByRef ord() As Long, ByVal nOrd As Long)
    Dim n As Long, i As Long, k As Long
    Dim tsk As Long
    Dim esOrd As Long, impOrd As Long
    Dim D As Long
    Dim drv As Long
    Dim hasPred As Boolean

    ReDim fES(1 To rCount): ReDim fEF(1 To rCount)
    ReDim fDone(1 To rCount): ReDim fDrv(1 To rCount)

    For k = 1 To nOrd
        tsk = ord(k)
        D = rcDurDays(tsk)

        If rPin(tsk) Then
            If rStartOK(tsk) Then fES(tsk) = rcOrdOf(rStart0(tsk))
            If rFinOK(tsk) Then
                fEF(tsk) = rcOrdOf(rFin0(tsk))
            Else
                fEF(tsk) = fES(tsk) + rcSpan(D)
            End If
            fDone(tsk) = True
            fDrv(tsk) = 0
            GoTo NextTask
        End If

        esOrd = 0
        drv = 0
        hasPred = False

        For i = 1 To lkN
            If lkS(i) = tsk Then
                hasPred = True
                If fDone(lkP(i)) Then
                    impOrd = rcImposedStart(i, D)
                    If impOrd > esOrd Then
                        esOrd = impOrd
                        drv = lkP(i)
                    End If
                End If
            End If
        Next i

        If rSNETOK(tsk) Then
            impOrd = rcOrdOf(rSNET(tsk))
            If impOrd > esOrd Then
                esOrd = impOrd
                drv = 0
            End If
        End If

        If Not hasPred Then
            If Not rSNETOK(tsk) Then
                If rStartOK(tsk) Then
                    impOrd = rcOrdOf(rStart0(tsk))
                    If impOrd > esOrd Then esOrd = impOrd
                End If
            End If
        End If

        If esOrd < 1 Then esOrd = 1
        fES(tsk) = esOrd
        fEF(tsk) = esOrd + rcSpan(D)
        fDrv(tsk) = drv
        fDone(tsk) = True

NextTask:
    Next k
End Sub

Private Function rcImposedStart(ByVal li As Long, ByVal D As Long) As Long
    Dim p As Long
    Dim lag As Long
    Dim o As Long
    p = lkP(li)
    lag = CLng(rcRound(lkL(li)))
    Select Case lkC(li)
        Case "SS"
            rcImposedStart = fES(p) + lag
        Case "FF"
            o = fEF(p) + lag
            rcImposedStart = o - rcSpan(D)
        Case "SF"
            o = fES(p) + lag
            rcImposedStart = o - rcSpan(D)
        Case Else
            rcImposedStart = fEF(p) + lag + 1
    End Select
    If rcImposedStart < 1 Then rcImposedStart = 1
End Function

Private Function rcSpan(ByVal D As Long) As Long
    If D <= 1 Then
        rcSpan = 0
    Else
        rcSpan = D - 1
    End If
End Function

Private Function rcDurDays(ByVal i As Long) As Long
    Dim D As Double
    If Not rDurOK(i) Then
        rcDurDays = 0
        Exit Function
    End If
    D = rDur(i)
    If D <= 0 Then
        rcDurDays = 0
    Else
        rcDurDays = CLng(rcRoundUp(D))
    End If
End Function

'================================================
' OUTPUT
'================================================
Private Sub rcWriteResults()
    Dim ws As Worksheet
    Dim i As Long, r As Long
    Dim nS As Long, nF As Long, nUn As Long
    Dim mx As Long, dS As Long, dF As Long
    Dim cs As Long, cf As Long
    Dim v As Variant
    Dim msg As String

    Set ws = rcResetSheet(OUT_SHEET)

    ws.Range("A10").Value = "Task ID"
    ws.Range("B10").Value = "Name"
    ws.Range("C10").Value = "Duration used"
    ws.Range("D10").Value = "Baseline Start"
    ws.Range("E10").Value = "Baseline Finish"
    ws.Range("F10").Value = "Calc Start"
    ws.Range("G10").Value = "Calc Finish"
    ws.Range("H10").Value = "Start delta, wd"
    ws.Range("I10").Value = "Finish delta, wd"
    ws.Range("J10").Value = "Driving pred"
    ws.Range("K10").Value = "Note"
    ws.Range("A10:K10").Font.Bold = True
    ws.Range("A10:K10").Interior.Color = RGB(221, 235, 247)
    ws.Range("A:A").NumberFormat = "@"
    ws.Range("J:J").NumberFormat = "@"

    r = 11
    For i = 1 To rCount
        ws.Cells(r, 1).Value = rIDs(i)
        ws.Cells(r, 2).Value = rNames(i)
        ws.Cells(r, 3).Value = rcDurDays(i)

        If rStartOK(i) Then ws.Cells(r, 4).Value = CDate(rStart0(i))
        If rFinOK(i) Then ws.Cells(r, 5).Value = CDate(rFin0(i))

        cs = rcSerOf(fES(i))
        cf = rcSerOf(fEF(i))
        ws.Cells(r, 6).Value = CDate(cs)
        ws.Cells(r, 7).Value = CDate(cf)

        If rStartOK(i) Then
            dS = rcOrdOf(CDbl(cs)) - rcOrdOf(rStart0(i))
            ws.Cells(r, 8).Value = dS
            If dS <> 0 Then nS = nS + 1
            If Abs(dS) > mx Then mx = Abs(dS)
        Else
            ws.Cells(r, 8).Value = "n/a"
            nUn = nUn + 1
        End If

        If rFinOK(i) Then
            dF = rcOrdOf(CDbl(cf)) - rcOrdOf(rFin0(i))
            ws.Cells(r, 9).Value = dF
            If dF <> 0 Then nF = nF + 1
            If Abs(dF) > mx Then mx = Abs(dF)
        Else
            ws.Cells(r, 9).Value = "n/a"
        End If

        If fDrv(i) > 0 Then ws.Cells(r, 10).Value = rIDs(fDrv(i))
        If rPin(i) Then ws.Cells(r, 11).Value = "pinned"
        If Not rDurOK(i) Then ws.Cells(r, 11).Value = "duration unreadable, treated as 0"
        r = r + 1
    Next i

    ws.Range("D11").Resize(rCount, 4).NumberFormat = "yyyy-mm-dd"

    ws.Range("A1").Value = "Schedule recalculation"
    ws.Range("A2").Value = "Tasks"
    ws.Range("B2").Value = rCount
    ws.Range("A3").Value = "Relationships"
    ws.Range("B3").Value = lkN
    ws.Range("A4").Value = "Working days in calendar"
    ws.Range("B4").Value = cMaxOrd
    ws.Range("A5").Value = "Rows where Calc Start <> Baseline"
    ws.Range("B5").Value = nS
    ws.Range("A6").Value = "Rows where Calc Finish <> Baseline"
    ws.Range("B6").Value = nF
    ws.Range("A7").Value = "Largest delta, working days"
    ws.Range("B7").Value = mx
    ws.Range("A8").Value = "Unparsed predecessor tokens"
    ws.Range("B8").Value = rUnparsed.Count
    ws.Range("A1:A8").Font.Bold = True

    If rUnparsed.Count > 0 Then
        r = r + 2
        ws.Cells(r, 1).Value = "Predecessor tokens that could not be parsed"
        ws.Cells(r, 1).Font.Bold = True
        r = r + 1
        For Each v In rUnparsed.Keys
            ws.Cells(r, 1).NumberFormat = "@"
            ws.Cells(r, 1).Value = v
            r = r + 1
        Next v
    End If

    On Error Resume Next
    ws.Columns("A:K").AutoFit
    If ws.Columns("B").ColumnWidth > 50 Then ws.Columns("B").ColumnWidth = 50
    ws.Activate
    ws.Range("A11").Select
    On Error GoTo 0

    msg = "Recalc written to " & OUT_SHEET & vbCrLf & vbCrLf
    msg = msg & "Tasks: " & rCount & "   Relationships: " & lkN & vbCrLf
    msg = msg & "Start mismatches: " & nS & vbCrLf
    msg = msg & "Finish mismatches: " & nF & vbCrLf
    msg = msg & "Largest delta: " & mx & " working days" & vbCrLf
    msg = msg & "Unparsed pred tokens: " & rUnparsed.Count & vbCrLf & vbCrLf
    If nS = 0 Then
        If nF = 0 Then
            msg = msg & "All rows reproduced. The model is a faithful match, so what-if edits can be trusted."
        End If
    End If
    If nS > 0 Or nF > 0 Then
        msg = msg & "Sort by the delta columns. Those rows use Project features this engine does not model."
    End If
    MsgBox msg, vbInformation, "Recalc"
End Sub

'================================================
' HELPERS
'================================================
Private Sub rcBail(ByVal s As String)
    Err.Raise 5, "Recalc", s
End Sub

Private Function rcNorm(ByVal s As String) As String
    Dim i As Long, c As String, o As String, junk As String
    junk = " _-.()/\'" & vbTab
    s = LCase(Trim(s))
    For i = 1 To Len(s)
        c = Mid(s, i, 1)
        If InStr(junk, c) = 0 Then o = o & c
    Next i
    rcNorm = o
End Function

Private Function rcFindCol(ByVal d As Object, ByVal cands As String) As Long
    Dim a() As String
    Dim i As Long
    a = Split(cands, "|")
    For i = LBound(a) To UBound(a)
        If d.Exists(a(i)) Then
            rcFindCol = d(a(i))
            Exit Function
        End If
    Next i
End Function

Private Function rcLongestKnownID(ByVal t As String) As String
    Dim L As Long, cand As String
    For L = Len(t) To 1 Step -1
        cand = Left(t, L)
        If rIdx.Exists(cand) Then
            rcLongestKnownID = cand
            Exit Function
        End If
    Next L
End Function

Private Function rcParseLag(ByVal s As String) As Double
    Dim i As Long, c As String, o As String
    s = Trim(s)
    If Len(s) = 0 Then Exit Function
    s = Replace(s, ",", ".")
    For i = 1 To Len(s)
        c = Mid(s, i, 1)
        If InStr("0123456789.+-", c) > 0 Then
            o = o & c
        Else
            Exit For
        End If
    Next i
    If Len(o) = 0 Then Exit Function
    rcParseLag = Val(o)
End Function

Private Function rcToDur(ByVal v As Variant, ByRef ok As Boolean) As Double
    Dim s As String, i As Long, c As String, o As String
    ok = False
    On Error Resume Next
    If IsError(v) Then GoTo Done
    If IsNull(v) Then GoTo Done
    If IsEmpty(v) Then GoTo Done
    If IsNumeric(v) Then
        rcToDur = CDbl(v)
        ok = True
        GoTo Done
    End If
    s = Trim(Replace(CStr(v), ",", "."))
    For i = 1 To Len(s)
        c = Mid(s, i, 1)
        If InStr("0123456789.", c) > 0 Then
            o = o & c
        ElseIf Len(o) > 0 Then
            Exit For
        End If
    Next i
    If Len(o) > 0 Then
        rcToDur = Val(o)
        ok = True
    End If
Done:
    Err.Clear
    On Error GoTo 0
End Function

Private Function rcToDate(ByVal v As Variant, ByRef ok As Boolean) As Double
    Dim parts() As String
    Dim s As String
    ok = False
    On Error Resume Next
    If IsError(v) Then GoTo Done
    If IsNull(v) Then GoTo Done
    If IsEmpty(v) Then GoTo Done
    If IsDate(v) Then
        rcToDate = CDbl(CDate(v))
        ok = True
        GoTo Done
    End If
    If IsNumeric(v) Then
        If CDbl(v) > 0 Then
            rcToDate = CDbl(v)
            ok = True
        End If
        GoTo Done
    End If
    s = Trim(CStr(v))
    If Len(s) = 0 Then GoTo Done
    If InStr(s, "-") > 0 Then
        parts = Split(Left(s, 10), "-")
        If UBound(parts) = 2 Then
            If IsNumeric(parts(0)) Then
                If IsNumeric(parts(1)) Then
                    If IsNumeric(parts(2)) Then
                        rcToDate = CDbl(DateSerial(CLng(parts(0)), CLng(parts(1)), CLng(parts(2))))
                        ok = True
                        GoTo Done
                    End If
                End If
            End If
        End If
    End If
    rcToDate = CDbl(CDate(s))
    If Err.Number = 0 Then ok = True
Done:
    Err.Clear
    On Error GoTo 0
End Function

Private Function rcTruthy(ByVal v As Variant) As Boolean
    Dim s As String
    On Error Resume Next
    s = LCase(Trim(CStr(v)))
    On Error GoTo 0
    Select Case s
        Case "y", "yes", "true", "1", "x", "pin", "pinned", "locked", "manual"
            rcTruthy = True
    End Select
End Function

Private Function rcRound(ByVal d As Double) As Double
    rcRound = Int(d + 0.5)
    If d < 0 Then rcRound = -Int(-d + 0.5)
End Function

Private Function rcRoundUp(ByVal d As Double) As Double
    If d = Int(d) Then
        rcRoundUp = d
    Else
        rcRoundUp = Int(d) + 1
    End If
End Function

Private Function rcResetSheet(ByVal nm As String) As Worksheet
    Dim ws As Worksheet
    Dim cnt As Long
    Application.DisplayAlerts = False
    On Error Resume Next
    ThisWorkbook.Worksheets(nm).Delete
    On Error GoTo 0
    Application.DisplayAlerts = True
    cnt = ThisWorkbook.Worksheets.Count
    Set ws = ThisWorkbook.Worksheets.Add(, ThisWorkbook.Worksheets(cnt))
    ws.Name = nm
    Set rcResetSheet = ws
End Function
