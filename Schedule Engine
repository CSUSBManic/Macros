Option Explicit

'=================== SETTINGS ===================
Private Const SRC_SHEET As String = "Project View"
Private Const OUT_SHEET As String = "Recalc"
Private Const HOL_SHEET As String = "Holidays"
Private Const SRC_HDR_ROW As Long = 1
Private Const WORK_MON As Boolean = True
Private Const WORK_TUE As Boolean = True
Private Const WORK_WED As Boolean = True
Private Const WORK_THU As Boolean = True
Private Const WORK_FRI As Boolean = True
Private Const WORK_SAT As Boolean = False
Private Const WORK_SUN As Boolean = False
Private Const CAL_PAD_YEARS As Long = 6
'================================================

Private rIDs() As String
Private rNames() As String
Private rDur() As Double
Private rDurOK() As Boolean
Private rStart0() As Double
Private rFin0() As Double
Private rStartOK() As Boolean
