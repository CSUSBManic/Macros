Option Explicit

'==================== USER SETTINGS ====================
Private Const LAG_UNIT         As String  = "d"      ' suffix for lag; see caveat #1
Private Const CASE_SENSITIVE_IDS As Boolean = True   ' SPD StringIDs are case-sensitive
Private Const OUT_SHEET        As String  = "Project View"
Private Const DIAG_SHEET       As String  = "_View Diagnostics"
Private Const WRITE_DIAG       As Boolean = True
Private Const HEADER_ROW       As Long    = 1
Private Const LIST_SEP         As String  = ", "     ' use "; " for some locales
Private Const TOKEN_SEP        As String  = vbTab    ' internal delimiter only
Private Const DIAG_CAP         As Long    = 500
'=======================================================

Public Sub BuildProjectStyleScheduleView()

    Dim wsTSD As Worksheet, wsTasks As Worksheet, wsRel As Worksheet
    Dim aTSD As Variant, aTasks As Variant, aRel As Variant
    Dim hTSD As Object, hTasks As Object, hRel As Object
    Dim dName As Object, dRowIdx As Object, dPred As Object, dSucc As Object
    Dim cTsdID&, cTsdDur&, cTsdStart&, cTsdFin&
    Dim cTskID&, cTskName&
    Dim cRelP&, cRelS&, cRelT&, cRelL&
    Dim i&, n&, r&
    Dim sP$, sS$, sT$, sCode$, sTok$, sLag$
    Dim vLag As Variant
    Dim missName&, orphanP&, orphanS&, dupPK&, selfLoop&, unkType&
    Dim dSeen As Object
    Dim diagMissName As Object, diagOrphan As Object, diagUnkType As Object
    Dim oldCalc As XlCalculation

    On Error GoTo Fail
    oldCalc = Application.Calculation
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False

    '--- locate sheets -------------------------------------------------
    Set wsTSD = FindSheet(Array("taskscheduledata"))
    Set wsTasks = FindSheet(Array("tasks"))
    Set wsRel = FindSheet(Array("taskrelationships", "taskrelationship"))
    If wsTSD Is Nothing Then Err.Raise 5, , "Cannot find the 'Task Schedule Data' sheet."
    If wsTasks Is Nothing Then Err.Raise 5, , "Cannot find the 'Tasks' sheet."
    If wsRel Is Nothing Then Err.Raise 5, , "Cannot find the 'Task Relationships' sheet."

    '--- read blocks ---------------------------------------------------
    aTSD = ReadBlock(wsTSD)
    aTasks = ReadBlock(wsTasks)
    aRel = ReadBlock(wsRel)

    Set hTSD = GetHeaders(aTSD)
    Set hTasks = GetHeaders(aTasks)
    Set hRel = GetHeaders(aRel)

    '--- resolve columns ----------------------------------------------
    cTsdID = FindCol(hTSD, Array("taskid", "id"), "Task ID", wsTSD.Name)
    cTsdDur = FindCol(hTSD, Array("currentduration", "curduration", "durationcurrent"), _
                      "Current Duration", wsTSD.Name)
    cTsdStart = FindCol(hTSD, Array("currentstartdate", "currentstart"), _
                        "Current Start Date", wsTSD.Name)
    cTsdFin = FindCol(hTSD, Array("currentfinishdate", "currentfinish"), _
                      "Current Finish Date", wsTSD.Name)

    cTskID = FindCol(hTasks, Array("id", "taskid"), "ID", wsTasks.Name)
    cTskName = FindCol(hTasks, Array("name", "taskname"), "Name", wsTasks.Name)

    cRelP = FindCol(hRel, Array("predecessortaskid", "predecessorid", "predecessor"), _
                    "PredecessorTaskID", wsRel.Name)
    cRelS = FindCol(hRel, Array("successortaskid", "successorid", "successor"), _
                    "SuccessorTaskID", wsRel.Name)
    cRelT = FindCol(hRel, Array("relationshiptypeid", "relationshiptype", "type"), _
                    "RelationshipTypeID", wsRel.Name)
    cRelL = FindColOpt(hRel, Array("lagduration", "lag"))   ' optional

    '--- dictionaries --------------------------------------------------
    Set dName = NewDict(): Set dRowIdx = NewDict()
    Set dPred = NewDict(): Set dSucc = NewDict(): Set dSeen = NewDict()
    Set diagMissName = NewDict(): Set diagOrphan = NewDict(): Set diagUnkType = NewDict()

    ' Tasks: ID -> Name
    For i = HEADER_ROW + 1 To UBound(aTasks, 1)
        sP = CleanID(aTasks(i, cTskID))
        If Len(sP) > 0 Then
            If Not dName.Exists(sP) Then dName.Add sP, CStr(NzS(aTasks(i, cTskName)))
        End If
    Next i

    ' Task Schedule Data: ID -> output row order (drives token sort order)
    n = 0
    For i = HEADER_ROW + 1 To UBound(aTSD, 1)
        sP = CleanID(aTSD(i, cTsdID))
        If Len(sP) > 0 Then
            n = n + 1
            If Not dRowIdx.Exists(sP) Then dRowIdx.Add sP, n
        End If
    Next i
    If n = 0 Then Err.Raise 5, , "No Task IDs found in '" & wsTSD.Name & "'."

    '--- build relationship tokens ------------------------------------
    For i = HEADER_ROW + 1 To UBound(aRel, 1)
        sP = CleanID(aRel(i, cRelP))
        sS = CleanID(aRel(i, cRelS))
        If Len(sP) > 0 And Len(sS) > 0 Then

            sT = CStr(NzS(aRel(i, cRelT)))
            sCode = RelCode(sT)
            If sCode = "??" Then
                unkType = unkType + 1
                If Not diagUnkType.Exists(sT) Then diagUnkType.Add sT, 1
            End If

            If cRelL > 0 Then vLag = aRel(i, cRelL) Else vLag = Empty
            sLag = FmtLag(vLag)

            ' PK = Pred + Succ + Type
            If dSeen.Exists(sP & "|" & sS & "|" & sT) Then
                dupPK = dupPK + 1
            Else
                dSeen.Add sP & "|" & sS & "|" & sT, 1
            End If
            If sP = sS Then selfLoop = selfLoop + 1

            ' token describing the PREDECESSOR, filed under the successor
            sTok = MakeToken(sP, sCode, sT, sLag)
            AddTok dPred, sS, SortKey(dRowIdx, sP) & "|" & sTok

            ' token describing the SUCCESSOR, filed under the predecessor
            sTok = MakeToken(sS, sCode, sT, sLag)
            AddTok dSucc, sP, SortKey(dRowIdx, sS) & "|" & sTok

            If Not dRowIdx.Exists(sP) Then
                orphanP = orphanP + 1
                If diagOrphan.Count < DIAG_CAP Then If Not diagOrphan.Exists(sP) Then diagOrphan.Add sP, "Predecessor"
            End If
            If Not dRowIdx.Exists(sS) Then
                orphanS = orphanS + 1
                If diagOrphan.Count < DIAG_CAP Then If Not diagOrphan.Exists(sS) Then diagOrphan.Add sS, "Successor"
            End If
        End If
    Next i

    '--- assemble output ----------------------------------------------
    Dim outA As Variant
    ReDim outA(1 To n + 1, 1 To 7)
    outA(1, 1) = "Task ID": outA(1, 2) = "Name": outA(1, 3) = "Current Duration"
    outA(1, 4) = "Current Start Date": outA(1, 5) = "Current Finish Date"
    outA(1, 6) = "Predecessors": outA(1, 7) = "Successors"

    r = 1
    For i = HEADER_ROW + 1 To UBound(aTSD, 1)
        sP = CleanID(aTSD(i, cTsdID))
        If Len(sP) > 0 Then
            r = r + 1
            outA(r, 1) = sP
            If dName.Exists(sP) Then
                outA(r, 2) = dName(sP)
            Else
                missName = missName + 1
                If diagMissName.Count < DIAG_CAP Then If Not diagMissName.Exists(sP) Then diagMissName.Add sP, 1
            End If
            outA(r, 3) = aTSD(i, cTsdDur)
            outA(r, 4) = aTSD(i, cTsdStart)
            outA(r, 5) = aTSD(i, cTsdFin)
            If dPred.Exists(sP) Then outA(r, 6) = JoinSorted(dPred(sP))
            If dSucc.Exists(sP) Then outA(r, 7) = JoinSorted(dSucc(sP))
        End If
    Next i

    '--- write --------------------------------------------------------
    Dim wsOut As Worksheet
    Set wsOut = ResetSheet(OUT_SHEET)
    wsOut.Range("A:A").NumberFormat = "@"
    wsOut.Range("F:G").NumberFormat = "@"
    wsOut.Range("A1").Resize(n + 1, 7).Value = outA
    wsOut.Range("D:E").NumberFormat = "yyyy-mm-dd"
    With wsOut.Range("A1").Resize(1, 7)
        .Font.Bold = True
        .Interior.Color = RGB(221, 235, 247)
    End With
    wsOut.Rows(1).AutoFilter
    wsOut.Range("A2").Select
    ActiveWindow.FreezePanes = False
    ActiveWindow.FreezePanes = True
    wsOut.Columns("A:G").AutoFit
    If wsOut.Columns("B").ColumnWidth > 55 Then wsOut.Columns("B").ColumnWidth = 55
    If wsOut.Columns("F").ColumnWidth > 45 Then wsOut.Columns("F").ColumnWidth = 45
    If wsOut.Columns("G").ColumnWidth > 45 Then wsOut.Columns("G").ColumnWidth = 45

    If WRITE_DIAG Then WriteDiag diagMissName, diagOrphan, diagUnkType, _
                                n, UBound(aRel, 1) - HEADER_ROW, missName, _
                                orphanP, orphanS, dupPK, selfLoop, unkType

    Application.EnableEvents = True
    Application.Calculation = oldCalc
    Application.ScreenUpdating = True

    MsgBox "Built '" & OUT_SHEET & "'." & vbCrLf & vbCrLf & _
           "Tasks written:              " & n & vbCrLf & _
           "Relationship rows read:     " & UBound(aRel, 1) - HEADER_ROW & vbCrLf & _
           "Names not found in Tasks:   " & missName & vbCrLf & _
           "Rel. IDs not in Sched Data: " & orphanP & " pred / " & orphanS & " succ" & vbCrLf & _
           "Duplicate PK rows:          " & dupPK & vbCrLf & _
           "Self-referencing links:     " & selfLoop & vbCrLf & _
           "Unrecognised rel. types:    " & unkType, _
           vbInformation, "IPMDAR SPD - Project View"
    Exit Sub

Fail:
    Application.EnableEvents = True
    On Error Resume Next
    Application.Calculation = oldCalc
    Application.ScreenUpdating = True
    On Error GoTo 0
    MsgBox "Failed: " & Err.Description, vbExclamation
End Sub

'==================== HELPERS ====================

Private Function MakeToken(ByVal sID$, ByVal sCode$, ByVal sRaw$, ByVal sLag$) As String
    ' MS Project convention: FS with zero lag shows the bare ID.
    If sCode = "??" Then
        MakeToken = sID & "[" & sRaw & "]" & sLag
    ElseIf sCode = "FS" And Len(sLag) = 0 Then
        MakeToken = sID
    Else
        MakeToken = sID & sCode & sLag
    End If
End Function

Private Function RelCode(ByVal s As String) As String
    Select Case Norm(s)
        Case "finishtostart", "fs": RelCode = "FS"
        Case "starttostart", "ss":  RelCode = "SS"
        Case "finishtofinish", "ff": RelCode = "FF"
        Case "starttofinish", "sf": RelCode = "SF"
        Case Else: RelCode = "??"
    End Select
End Function

Private Function FmtLag(ByVal v As Variant) As String
    Dim d As Double
    If IsEmpty(v) Or IsNull(v) Then Exit Function
    If Trim(CStr(v)) = "" Then Exit Function
    If Not IsNumeric(v) Then Exit Function
    d = CDbl(v)
    If d = 0 Then Exit Function
    FmtLag = IIf(d > 0, "+", "-") & Format$(Abs(d), "0.##") & LAG_UNIT
End Function

Private Function SortKey(ByVal dIdx As Object, ByVal sID As String) As String
    If dIdx.Exists(sID) Then
        SortKey = Format$(dIdx(sID), "0000000")
    Else
        SortKey = "9999999"          ' orphans sort last
    End If
End Function

Private Sub AddTok(ByRef d As Object, ByVal k As String, ByVal tok As String)
    If d.Exists(k) Then d(k) = d(k) & TOKEN_SEP & tok Else d.Add k, tok
End Sub

Private Function JoinSorted(ByVal s As String) As String
    Dim a() As String, i&, j&, t$
    a = Split(s, TOKEN_SEP)
    For i = LBound(a) + 1 To UBound(a)          ' insertion sort
        t = a(i): j = i - 1
        Do While j >= LBound(a)
            If a(j) <= t Then Exit Do
            a(j + 1) = a(j): j = j - 1
        Loop
        a(j + 1) = t
    Next i
    For i = LBound(a) To UBound(a)
        a(i) = Mid$(a(i), InStr(a(i), "|") + 1)
    Next i
    JoinSorted = Join(a, LIST_SEP)
End Function

Private Function CleanID(ByVal v As Variant) As String
    If IsError(v) Then Exit Function
    If IsEmpty(v) Or IsNull(v) Then Exit Function
    CleanID = Trim$(CStr(v))
End Function

Private Function NzS(ByVal v As Variant) As String
    If IsError(v) Or IsNull(v) Or IsEmpty(v) Then Exit Function
    NzS = CStr(v)
End Function

Private Function Norm(ByVal s As String) As String
    Dim i&, c$, o$
    s = LCase$(Trim$(s))
    For i = 1 To Len(s)
        c = Mid$(s, i, 1)
        If InStr(" _-.()/\" & vbTab, c) = 0 Then o = o & c
    Next i
    Norm = o
End Function

Private Function NewDict() As Object
    Set NewDict = CreateObject("Scripting.Dictionary")
    NewDict.CompareMode = IIf(CASE_SENSITIVE_IDS, 0, 1)
End Function

Private Function FindSheet(ByVal cands As Variant) As Worksheet
    Dim ws As Worksheet, k
    For Each ws In ThisWorkbook.Worksheets
        For Each k In cands
            If Norm(ws.Name) = CStr(k) Then Set FindSheet = ws: Exit Function
        Next k
    Next ws
End Function

Private Function ReadBlock(ByVal ws As Worksheet) As Variant
    Dim lr&, lc&, a As Variant
    With ws.UsedRange
        lr = .Row + .Rows.Count - 1
        lc = .Column + .Columns.Count - 1
    End With
    If lr <= HEADER_ROW Then Err.Raise 5, , "Sheet '" & ws.Name & "' has no data rows."
    a = ws.Range(ws.Cells(HEADER_ROW, 1), ws.Cells(lr, lc)).Value
    ReadBlock = a
End Function

Private Function GetHeaders(ByRef a As Variant) As Object
    Dim d As Object, c&, k$
    Set d = CreateObject("Scripting.Dictionary")
    d.CompareMode = 1
    For c = LBound(a, 2) To UBound(a, 2)
        k = Norm(NzS(a(HEADER_ROW, c)))
        If Len(k) > 0 Then If Not d.Exists(k) Then d.Add k, c
    Next c
    Set GetHeaders = d
End Function

Private Function FindColOpt(ByVal d As Object, ByVal cands As Variant) As Long
    Dim k
    For Each k In cands
        If d.Exists(CStr(k)) Then FindColOpt = d(CStr(k)): Exit Function
    Next k
End Function

Private Function FindCol(ByVal d As Object, ByVal cands As Variant, _
                         ByVal label As String, ByVal shName As String) As Long
    FindCol = FindColOpt(d, cands)
    If FindCol = 0 Then Err.Raise 5, , "Could not find a '" & label & _
        "' column on sheet '" & shName & "'. Check the header row (row " & HEADER_ROW & ")."
End Function

Private Function ResetSheet(ByVal nm As String) As Worksheet
    Dim ws As Worksheet
    Application.DisplayAlerts = False
    On Error Resume Next
    ThisWorkbook.Worksheets(nm).Delete
    On Error GoTo 0
    Application.DisplayAlerts = True
    Set ws = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
    ws.Name = nm
    Set ResetSheet = ws
End Function

Private Sub WriteDiag(dName As Object, dOrph As Object, dType As Object, _
                      ByVal nTasks&, ByVal nRel&, ByVal missName&, _
                      ByVal orphP&, ByVal orphS&, ByVal dupPK&, _
                      ByVal selfL&, ByVal unkT&)
    Dim ws As Worksheet, r&, k
    Set ws = ResetSheet(DIAG_SHEET)
    ws.Range("A1:B1").Value = Array("Check", "Value")
    ws.Range("A1:B1").Font.Bold = True
    r = 2
    ws.Cells(r, 1) = "Tasks written":              ws.Cells(r, 2) = nTasks: r = r + 1
    ws.Cells(r, 1) = "Relationship rows read":     ws.Cells(r, 2) = nRel: r = r + 1
    ws.Cells(r, 1) = "Names not found in Tasks":   ws.Cells(r, 2) = missName: r = r + 1
    ws.Cells(r, 1) = "Orphan predecessor refs":    ws.Cells(r, 2) = orphP: r = r + 1
    ws.Cells(r, 1) = "Orphan successor refs":      ws.Cells(r, 2) = orphS: r = r + 1
    ws.Cells(r, 1) = "Duplicate PK rows":          ws.Cells(r, 2) = dupPK: r = r + 1
    ws.Cells(r, 1) = "Self-referencing links":     ws.Cells(r, 2) = selfL: r = r + 1
    ws.Cells(r, 1) = "Unrecognised rel. types":    ws.Cells(r, 2) = unkT: r = r + 2

    ws.Cells(r, 1) = "Task IDs with no Name (capped " & DIAG_CAP & ")": ws.Cells(r, 1).Font.Bold = True: r = r + 1
    For Each k In dName.Keys: ws.Cells(r, 1) = k: r = r + 1: Next k
    r = r + 1
    ws.Cells(r, 1) = "Rel. IDs absent from Task Schedule Data": ws.Cells(r, 1).Font.Bold = True: r = r + 1
    For Each k In dOrph.Keys: ws.Cells(r, 1) = k: ws.Cells(r, 2) = dOrph(k): r = r + 1: Next k
    r = r + 1
    ws.Cells(r, 1) = "Unrecognised RelationshipTypeID values": ws.Cells(r, 1).Font.Bold = True: r = r + 1
    For Each k In dType.Keys: ws.Cells(r, 1) = k: r = r + 1: Next k

    ws.Columns("A:B").AutoFit
End Sub
